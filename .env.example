# Sanity project — from https://sanity.io/manage
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Write token, used by the import and seed scripts only. Never needed by the
# Studio itself, and never by the frontend — the API reads published documents
# with a read token or anonymously, depending on dataset visibility.
SANITY_WRITE_TOKEN=

# Path to a superlogic-ui checkout. Used by `npm run tokens:manifest` to work
# out which CSS variables the apps actually reference.
SUPERLOGIC_UI_PATH=../superlogic-ui

# Directory holding the Figma exports, used by `npm run tokens:import`:
#   <dir>/foundation/{desktop,wide desktop,tablet,mobile}.tokens.json
#   <dir>/theme/<brand>.tokens.json
FIGMA_EXPORT_DIR=./figma-exports
